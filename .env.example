# Copy to .env (or set these in your host's dashboard). Never commit the real values.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# Leave empty to use SQLite locally. On a host use its PostgreSQL URL:
DATABASE_URL=postgres://user:password@host:5432/dbname
# Machines report telemetry with this key (see agent/telemetry_agent.py). Empty = API disabled.
TELEMETRY_API_KEY=pick-a-long-random-key
